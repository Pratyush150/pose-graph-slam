__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.DS_Store

# Benchmark datasets are fetched, never committed: their upstream mirrors are
# LGPL/GPL/BSD licensed. See tools/fetch_datasets.py.
data/*.g2o
data/*.txt
data/*.dat
data/*.part

# Generated figures. The small set used by the README is copied into
# docs/images/ and committed from there.
benchmarks/output/*
!benchmarks/output/.gitkeep
!benchmarks/output/README.md
